# ==========================================================
# DISTRIC C - VARIABLES DE ENTORNO
# Render usa las variables del Dashboard.
# Localhost puede usar un archivo .env (ver .env.local.example).
# ==========================================================

# Django / Render
SECRET_KEY=
DATABASE_URL=
DEBUG=False

# Localhost (solo se usan cuando DATABASE_URL está vacío)
LOCAL_DATABASE_ENGINE=postgres
POSTGRES_DB=mapas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Google Maps / Routes / Weather / Elevation
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opcionales
PUBLIC_BASE_URL=
EXTRA_ALLOWED_HOSTS=
EXTRA_CSRF_TRUSTED_ORIGINS=
NOMINATIM_USER_AGENT=DistricC-Tesis/1.0
RUTAS_MODO_PRUEBA_CLAVE=
CEDULA_LOOKUP_URL=
CEDULA_LOOKUP_TOKEN=
PDF_VALIDADOR_NOMBRES=
PDF_VALIDADOR_APELLIDOS=
PDF_VALIDADOR_DOCUMENTO=
